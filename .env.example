# Discord Bot Credentials
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_dev_guild_id_here_optional

# Database Connection (PostgreSQL VM Externa / Cloud)
# Formato: postgresql://USUARIO:PASSWORD@IP_O_HOST_DE_TU_VM:5432/NOMBRE_DB?schema=public
DATABASE_URL="postgresql://postgres:tu_password_aqui@IP_DE_TU_VM:5432/sinford_underworld?schema=public"

# Environment
NODE_ENV=development
