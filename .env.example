# Discord Bot Credentials & Embedded Activity OAuth2
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
VITE_DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
DISCORD_GUILD_ID=your_dev_guild_id_here_optional

# JWT Secret para sesiones stateless del juego
SESSION_JWT_SECRET=super_secret_jwt_key_change_in_production

# Database Connection (PostgreSQL VM Externa / Cloud)
# Formato: postgresql://USUARIO:PASSWORD@IP_O_HOST_DE_TU_VM:5432/NOMBRE_DB?schema=public
DATABASE_URL="postgresql://postgres:tu_password_aqui@IP_DE_TU_VM:5432/sinford_underworld?schema=public"

# Environment & Server Settings
PORT=3000
NODE_ENV=development
